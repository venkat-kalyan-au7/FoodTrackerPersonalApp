NODE_ENV=development
PORT=4000

FRONTEND_URL=http://localhost:5173

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

USDA_FDC_API_KEY=

# AI is optional. The app must work when false.
ENABLE_AI_FOOD_MATCHING=false
AI_PROVIDER=GEMINI

# Stable lightweight default model
AI_MODEL=gemini-2.5-flash-lite

# Optional advanced model for complex recipe extraction only
AI_ADVANCED_MODEL=gemini-2.5-flash

# Optional later experiment after checking availability and limits
AI_FUTURE_MODEL=gemini-3.1-flash-lite

GEMINI_API_KEY=

MAX_IMAGE_UPLOAD_MB=2
